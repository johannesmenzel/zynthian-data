plug:mode
	a lv2:Parameter ;
	pg:group plug:G_SETUP ;
    lv2:displayPriority 100 ;
	rdfs:label "Mode" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 7	 ;
	lv2:portProperty lv2:enumeration ;
	lv2:scalePoint [
		rdfs:label "Vintage Opto" ;
		rdf:value 0 ;
	], [
		rdfs:label "Vintage FET" ;
		rdf:value 1 ;
	], [
		rdfs:label "Classic VCA" ;
		rdf:value 2 ;
	], [
		rdfs:label "Vintage VCA (Bus)" ;
		rdf:value 3 ;
	], [
		rdfs:label "Studio FET" ;
		rdf:value 4 ;
	], [
		rdfs:label "Studio VCA" ;
		rdf:value 5 ;
	], [
		rdfs:label "Digital" ;
		rdf:value 6 ;
	], [
		rdfs:label "Multiband" ;
		rdf:value 7 ;
	] .

plug:bypass
	a lv2:Parameter ;
