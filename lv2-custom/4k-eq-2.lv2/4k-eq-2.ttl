@prefix dg:    <http://www.darkglass.com/lv2/ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix spdx:  <http://spdx.org/rdf/terms#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix unit:  <http://lv2plug.in/ns/extensions/units#> .
@prefix plug:  <https://dusk-audio.github.io/plugins/4k-eq-2> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .

<https://dusk-audio.github.io/plugins/4k-eq-2>
    a lv2:EQPlugin, lv2:Plugin, doap:Project ;

    lv2:extensionData opts:interface ,
                      <http://kxstudio.sf.net/ns/lv2ext/programs#Interface> ;

    lv2:optionalFeature <http://lv2plug.in/ns/lv2core#hardRTCapable> ,
                        <http://lv2plug.in/ns/ext/buf-size#boundedBlockLength> ;

    lv2:requiredFeature opts:options ,
                        <http://lv2plug.in/ns/ext/urid#map> ;

    opts:supportedOption <http://lv2plug.in/ns/ext/buf-size#nominalBlockLength> ,
                         <http://lv2plug.in/ns/ext/buf-size#maxBlockLength> ,
                         <http://lv2plug.in/ns/ext/parameters#sampleRate> ;

    ui:ui <https://dusk-audio.github.io/plugins/4k-eq-2#DAF_UI> ;

    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "lv2_audio_in_1" ;
        lv2:name "Audio Input 1" ;
    ] ,
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "lv2_audio_in_2" ;
        lv2:name "Audio Input 2" ;
    ] ;

    lv2:port [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "lv2_audio_out_1" ;
        lv2:name "Audio Output 1" ;
    ] ,
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "lv2_audio_out_2" ;
        lv2:name "Audio Output 2" ;
    ] ;

    lv2:port [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:name "Latency" ;
        lv2:symbol "lv2_latency" ;
        lv2:designation lv2:latency ;
        lv2:portProperty lv2:reportsLatency, lv2:integer, <http://lv2plug.in/ns/ext/port-props#notOnGUI> ;
    ] ;

    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:name "HPF Frequency" ;
        lv2:symbol "hpf_freq" ;
        lv2:default 16 ;
        lv2:minimum 16 ;
        lv2:maximum 350 ;
        unit:unit unit:hz ;
        pg:group plug:G_FILTER ;
        lv2:displayPriority 4 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:name "HPF Enabled" ;
        lv2:symbol "hpf_enabled" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
        lv2:portProperty lv2:integer ;
        pg:group plug:G_FILTER ;
        lv2:displayPriority 3 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:name "LPF Frequency" ;
        lv2:symbol "lpf_freq" ;
        lv2:default 15201 ;
        lv2:minimum 3000 ;
        lv2:maximum 15201 ;
        unit:unit unit:hz ;
        pg:group plug:G_FILTER ;
        lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:name "LPF Enabled" ;
        lv2:symbol "lpf_enabled" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
        lv2:portProperty lv2:integer ;
        pg:group plug:G_FILTER ;
        lv2:displayPriority 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:name "LF Gain" ;
        lv2:symbol "lf_gain" ;
        lv2:default 0 ;
        lv2:minimum -15 ;
        lv2:maximum 15 ;
        unit:unit unit:db ;
        pg:group plug:G_LF ;
        lv2:displayPriority 4 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:name "LF Frequency" ;
        lv2:symbol "lf_freq" ;
        lv2:default 200 ;
        lv2:minimum 30 ;
        lv2:maximum 450 ;
        unit:unit unit:hz ;
        pg:group plug:G_LF ;
        lv2:displayPriority 3 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:name "LF Bell Mode" ;
        lv2:symbol "lf_bell" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
        lv2:portProperty lv2:integer ;
        pg:group plug:G_LF ;
        lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:name "LM Gain" ;
        lv2:symbol "lm_gain" ;
        lv2:default 0 ;
        lv2:minimum -15 ;
        lv2:maximum 15 ;
        unit:unit unit:db ;
        pg:group plug:G_LMF ;
        lv2:displayPriority 4 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:name "LM Frequency" ;
        lv2:symbol "lm_freq" ;
        lv2:default 1000 ;
        lv2:minimum 200 ;
        lv2:maximum 2500 ;
        unit:unit unit:hz ;
        pg:group plug:G_LMF ;
        lv2:displayPriority 3 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:name "LM Q" ;
        lv2:symbol "lm_q" ;
        lv2:default 1.5 ;
        lv2:minimum 0.5 ;
        lv2:maximum 3 ;
        pg:group plug:G_LMF ;
        lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:name "HM Gain" ;
        lv2:symbol "hm_gain" ;
        lv2:default 0 ;
        lv2:minimum -15 ;
        lv2:maximum 15 ;
        unit:unit unit:db ;
        pg:group plug:G_HMF ;
        lv2:displayPriority 4 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:name "HM Frequency" ;
        lv2:symbol "hm_freq" ;
        lv2:default 3000 ;
        lv2:minimum 600 ;
        lv2:maximum 7000 ;
        unit:unit unit:hz ;
        pg:group plug:G_HMF ;
        lv2:displayPriority 3 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ;
        lv2:name "HM Q" ;
        lv2:symbol "hm_q" ;
        lv2:default 1.5 ;
        lv2:minimum 0.5 ;
        lv2:maximum 3 ;
        pg:group plug:G_HMF ;
        lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 18 ;
        lv2:name "HF Gain" ;
        lv2:symbol "hf_gain" ;
        lv2:default 0 ;
        lv2:minimum -15 ;
        lv2:maximum 15 ;
        unit:unit unit:db ;
        pg:group plug:G_HF ;
        lv2:displayPriority 4 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 19 ;
        lv2:name "HF Frequency" ;
        lv2:symbol "hf_freq" ;
        lv2:default 8000 ;
        lv2:minimum 1500 ;
        lv2:maximum 16000 ;
        unit:unit unit:hz ;
        pg:group plug:G_HF ;
        lv2:displayPriority 3 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 20 ;
        lv2:name "HF Bell Mode" ;
        lv2:symbol "hf_bell" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
        lv2:portProperty lv2:integer ;
        pg:group plug:G_HF ;
        lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 21 ;
        lv2:name "EQ Type" ;
        lv2:symbol "eq_type" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:enumeration ;
        lv2:scalePoint [
            rdfs:label  "Brown" ;
            rdf:value 0 ;
        ] ,
        [
            rdfs:label  "Black" ;
            rdf:value 1 ;
        ] ;
        lv2:portProperty lv2:integer ;
        pg:group plug:G_SETUP ;
        lv2:displayPriority 10 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 22 ;
        lv2:name "Enabled" ;
        lv2:symbol "lv2_enabled" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled , lv2:integer ;
        lv2:designation lv2:enabled ;
        pg:group plug:G_SETUP ;
        lv2:displayPriority 9 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 23 ;
        lv2:name "Input Gain" ;
        lv2:symbol "input_gain" ;
        lv2:default 0 ;
        lv2:minimum -12 ;
        lv2:maximum 12 ;
        unit:unit unit:db ;
        pg:group plug:G_SETUP ;
        lv2:displayPriority 8 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 24 ;
        lv2:name "Output Gain" ;
        lv2:symbol "output_gain" ;
        lv2:default 0 ;
        lv2:minimum -12 ;
        lv2:maximum 12 ;
        unit:unit unit:db ;
        pg:group plug:G_SETUP ;
        lv2:displayPriority 7 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 25 ;
        lv2:name "Saturation" ;
        lv2:symbol "saturation" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        unit:unit unit:pc ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#notOnGUI> ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#expensive> ,
                         <http://kxstudio.sf.net/ns/lv2ext/props#NonAutomatable> ;
        pg:group plug:G_SETUP ;
        lv2:displayPriority 6 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 26 ;
        lv2:name "Oversampling" ;
        lv2:symbol "oversampling" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:enumeration ;
        lv2:scalePoint [
            rdfs:label  "1x" ;
            rdf:value 0 ;
        ] ,
        [
            rdfs:label  "2x" ;
            rdf:value 1 ;
        ] ,
        [
            rdfs:label  "4x" ;
            rdf:value 2 ;
        ] ;
        lv2:portProperty lv2:integer ;
        pg:group plug:G_SETUP ;
        lv2:displayPriority 5 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 27 ;
        lv2:name "M/S Mode" ;
        lv2:symbol "ms_mode" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#notOnGUI> ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#expensive> ,
                         <http://kxstudio.sf.net/ns/lv2ext/props#NonAutomatable> ;
        pg:group plug:G_SETUP ;
        lv2:displayPriority 4 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 28 ;
        lv2:name "Spectrum Pre/Post" ;
        lv2:symbol "spectrum_prepost" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
        lv2:portProperty lv2:integer ;
        pg:group plug:G_SETUP ;
        lv2:displayPriority 3 ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#notOnGUI> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 29 ;
        lv2:name "Auto Gain Compensation" ;
        lv2:symbol "auto_gain" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
        lv2:portProperty lv2:integer ;
        pg:group plug:G_SETUP ;
        lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 30 ;
        lv2:name "Show Graph" ;
        lv2:symbol "show_graph" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
        lv2:portProperty lv2:integer ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#expensive> ,
                         <http://kxstudio.sf.net/ns/lv2ext/props#NonAutomatable> ;
        pg:group plug:G_SETUP ;
        lv2:displayPriority 1 ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#notOnGUI> ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 31 ;
        lv2:name "Out Peak L" ;
        lv2:symbol "out_peak_l" ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 32 ;
        lv2:name "Out Peak R" ;
        lv2:symbol "out_peak_r" ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
    ] ;

    rdfs:comment "British console EQ emulation: 4-band parametric EQ with high/low filters, Brown/Black voicings and native console nonlinearity, oversampled for cramp-free high-frequency response." ;

    mod:brand "Dusk Audio" ;
    mod:label "4K EQ 2" ;

    doap:name "4K EQ 2" ;
    doap:license <http://spdx.org/licenses/GPL-3.0-or-later.html> ;

    doap:maintainer [
        foaf:name "Dusk Audio" ;
        foaf:homepage <https://dusk-audio.github.io/> ;
    ] ;

    lv2:microVersion 5 ;
    lv2:minorVersion 2 .

plug:G_FILTER
a pg:ControlGroup ;
lv2:name "Filter" ;
lv2:symbol "g_filter" ;
lv2:displayPriority 10 .

plug:G_LF
a pg:ControlGroup ;
lv2:name "LF" ;
lv2:symbol "g_lf" ;
lv2:displayPriority 9 .

plug:G_LMF
a pg:ControlGroup ;
lv2:name "LMF" ;
lv2:symbol "g_lmf" ;
lv2:displayPriority 8 .

plug:G_HMF
a pg:ControlGroup ;
lv2:name "HMF" ;
lv2:symbol "g_hmf" ;
lv2:displayPriority 7 .

plug:G_HF
a pg:ControlGroup ;
lv2:name "HF" ;
lv2:symbol "g_hf" ;
lv2:displayPriority 6 .

plug:G_SETUP
a pg:ControlGroup ;
lv2:name "Setup" ;
lv2:symbol "g_setup" ;
lv2:displayPriority 5 .